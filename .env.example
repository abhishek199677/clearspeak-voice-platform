# ClearSpeak AI — environment configuration
# Copy this file to .env and adjust values:  cp .env.example .env

# ---- Application ----
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---- ASR (speech-to-text) ----
# whisper = free, local. deepgram = cloud (needs DEEPGRAM_API_KEY)
ASR_PROVIDER=whisper
WHISPER_MODEL=base
# DEEPGRAM_API_KEY=

# ---- TTS (text-to-speech) ----
# edge = free Microsoft Edge neural voices (200+ languages, no API key)
TTS_PROVIDER=edge
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ---- LLM (Agent mode) ----
# Requires a valid OpenAI API key for real answers.
# Without one the agent still works using built-in local replies.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=200
# For fully local LLM: LLM_PROVIDER=ollama (requires `ollama serve`)

# ---- Translation ----
# google = free, no API key, 100+ languages. local = built-in phrasebook.
# The backend always falls back automatically if a provider fails.
TRANSLATION_PROVIDER=google
DEFAULT_LANGUAGE=en
ENABLE_AUTO_TRANSLATE=true

# ---- Pipeline ----
# Default mode when a session starts: agent | translation
DEFAULT_PIPELINE_MODE=agent

# ---- India ----
INDIA_DEFAULT_LANGUAGE=hi
ENABLE_INDIA_LANGUAGES=true

# ---- Server ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]
